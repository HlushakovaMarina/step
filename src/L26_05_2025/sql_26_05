3. SQL-запросы для проверки
-Список всех мероприятий с указанием места проведения и оставшихся мест.
SELECT * FROM
    events e
JOIN
    venues v ON e.venue_id = v.venue_id;
- Список бронирований конкретного пользователя (по email).
SELECT
    b.booking_id,
    e.name AS eventName,
    b.seatsbooked,
    b.booking_date,
    b.status
FROM bookings b
JOIN events e ON b.event_id = e.event_id
JOIN users u ON b.user_id = u.user_id
WHERE u.email = 'truhina_m@mail.ru';

- Общая выручка по каждому мероприятию (цена билета × количество забронированных мест).
SELECT
    e.name AS eventname,
    SUM(e.ticketPrice * b.seatsbooked) AS totalrevenue
FROM events e
JOIN bookings b ON e.event_id = b.event_id
GROUP BY e.event_id;

- Мероприятия, у которых не осталось свободных мест (считаем, что места ограничены TotalSeats).
  SELECT
      e.name AS eventname
  FROM events e
  WHERE e.totalseats <= (
          SELECT
              SUM(b.SeatsBooked)
          FROM
              bookings b
          WHERE
              b.event_id = e.event_id AND b.status = 'confirmed'
      );