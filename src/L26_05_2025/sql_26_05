3. SQL-запросы для проверки
-Список всех мероприятий с указанием места проведения и оставшихся мест.
SELECT
    e.Name AS EventName,
    v.Name AS VenueName,
    v.Capacity - e.TotalSeats AS RemainingSeats
FROM
    Events e
JOIN
    Venues v ON e.VenueID = v.VenueID;
- Список бронирований конкретного пользователя (по email).
SELECT
    b.BookingID,
    e.Name AS EventName,
    b.SeatsBooked,
    b.BookingDate,
    b.Status
FROM
    Bookings b
JOIN
    Events e ON b.EventID = e.EventID
JOIN
    Users u ON b.UserID = u.UserID
WHERE
    u.Email = 'truhina_m@mail.ru';

- Общая выручка по каждому мероприятию (цена билета × количество забронированных мест).
SELECT
    e.Name AS EventName,
    SUM(e.TicketPrice * b.SeatsBooked) AS TotalRevenue
FROM
    Events e
JOIN
    Bookings b ON e.EventID = b.EventID
GROUP BY
    e.EventID;

- Мероприятия, у которых не осталось свободных мест (считаем, что места ограничены TotalSeats).
  SELECT
      e.Name AS EventName
  FROM
      Events e
  WHERE
      e.TotalSeats <= (
          SELECT
              SUM(b.SeatsBooked)
          FROM
              Bookings b
          WHERE
              b.EventID = e.EventID AND b.Status = 'confirmed'
      );